  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "每屏唯一的主动作，舆图蓝底白字。",
      "html": "<button class='ds-btn-primary' type='button'>新建节点</button>",
      "css": ".ds-btn-primary { height: 32px; padding: 0 14px; border: 1px solid #165dff; border-radius: 4px; background: #165dff; color: #ffffff; font: 500 13px/1 'PingFang SC', 'Microsoft YaHei', sans-serif; cursor: pointer; transition: background 200ms ease, border-color 200ms ease, box-shadow 200ms ease; } .ds-btn-primary:hover { background: #4080ff; border-color: #4080ff; } .ds-btn-primary:active { background: #0e42d2; border-color: #0e42d2; } .ds-btn-primary:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(22, 93, 255, 0.16); }"
    },
    {
      "name": "Secondary Button",
