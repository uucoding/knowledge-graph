      "html": "<div class='ds-legend'><div class='ds-legend-head'>图层 · 节点类型</div><ul><li><i style='background:#165dff'></i><span>技术</span><span class='ds-count'>24</span></li><li><i style='background:#00b42a'></i><span>组织</span><span class='ds-count'>18</span></li><li><i style='background:#ff7d00'></i><span>人物</span><span class='ds-count'>11</span></li></ul></div>",
      "css": ".ds-legend { width: 180px; padding: 12px; border: 1px solid #e5e6eb; border-radius: 8px; background: #ffffff; font: 400 12px/1.5 'PingFang SC', 'Microsoft YaHei', sans-serif; color: #4e5969; } .ds-legend-head { margin-bottom: 8px; color: #86909c; font-size: 12px; } .ds-legend ul { margin: 0; padding: 0; list-style: none; } .ds-legend li { display: flex; align-items: center; gap: 8px; height: 24px; } .ds-legend i { width: 8px; height: 8px; border-radius: 50%; } .ds-legend .ds-count { margin-left: auto; color: #86909c; font-variant-numeric: tabular-nums; }"
    }
